# FinAlly environment variables.
#
# Copy this file to .env at the project root and fill in what you have. Docker
# passes it with --env-file .env. Locally the backend runs from backend/ but
# loads the project-root .env, so there is only ever one env file.
#
# Every value below is a placeholder or an empty string. Never put a real
# credential in this file: it is committed, so it reaches every clone and stays
# in the git history permanently. Real values belong in .env, which is ignored.

# OpenRouter API key for the LLM chat assistant.
# Absent or empty: the app still starts and every feature except /api/chat
# works normally. /api/chat returns a normal-shaped response whose message
# explains that no key is configured, with empty trades and watchlist_changes
# arrays. It never raises, and startup never fails on a missing key.
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Massive (Polygon.io) API key for real market data. Optional.
# Empty: the built-in GBM market simulator is used. This is the recommended
# default, and the one to use for demos -- real quotes are flat outside
# market hours.
# Set and non-empty: the backend switches to Massive REST polling.
MASSIVE_API_KEY=

# Deterministic mock LLM responses, for E2E tests and offline development.
# "true": /api/chat returns keyword-triggered mock responses instead of
# calling OpenRouter. The mock still routes its trades and watchlist changes
# through the real execution and validation path.
LLM_MOCK=false

# Where the SQLite database file lives.
# Empty or unset: the repo-root db/finally.db, which is the directory the
# Docker bind mount targets.
# In the container the Dockerfile sets this to /app/db/finally.db.
FINALLY_DB_PATH=
