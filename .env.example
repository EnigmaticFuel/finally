# Copy this file to .env and fill in what you have. Every variable is optional:
# with all of them left blank FinAlly still starts, streams simulated prices and
# lets you trade. Docker passes the file through with --env-file .env, and the
# start scripts create .env from this template if it is missing.
#
# Never commit real keys. .env is gitignored; this file is not.

# OpenRouter API key, used for the AI chat panel.
# Without it every other feature works normally and POST /api/chat returns a
# normal response whose message explains that no key is configured. Startup
# never fails on a missing key.
OPENROUTER_API_KEY=

# Massive (Polygon.io) API key for real market data.
# Set it and the backend polls Massive for live quotes. Leave it blank and the
# built-in geometric Brownian motion simulator runs instead - which is the
# recommended default, because real quotes are flat outside market hours and a
# flat feed makes for a dull demo.
MASSIVE_API_KEY=

# Set to true for deterministic mock LLM responses instead of real calls.
# Used by the Playwright end-to-end suite so tests are fast, free and
# reproducible. The mock still routes its trades through the real validation
# and execution path.
LLM_MOCK=false
